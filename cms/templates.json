    "events-1": {
      "html": "<p style=\"text-align: center; ; white-space:pre-wrap;\" class=\"sqsrte-large\" data-rte-preserve-empty=\"true\">I give presentations to schools, libraries, museums, and community organizations, both in person and virtually. My talks explore the stories behind my books and the storytelling power of comics and I do my best to adapt each presentation to the audience. Programs include a behind-the-scenes look at my creative process and conclude with a Q&amp;A with the audience.</p>",
      "slots": [
        {
          "key": "text_01",
          "start": 107,
          "end": 473,
          "kind": "text",
          "original": "I give presentations to schools, libraries, museums, and community organizations, both in person and virtually. My talks explore the stories behind my books and the storytelling power of comics and I do my best to adapt each presentation to the audience. Programs include a behind-the-scenes look at my creative process and conclude with a Q&A with the audience."
        }
      ],
      "page": "events",
      "file": "presentations"
    },
    "events-2": {
      "html": "<h4 style=\"text-align: center; ; white-space:pre-wrap;\" data-rte-preserve-empty=\"true\">We Are Not Strangers</h4>",
      "slots": [
        {
          "key": "text_01",
          "start": 87,
          "end": 107,
          "kind": "text",
          "original": "We Are Not Strangers"
        }
      ],
      "page": "events",
      "file": "presentations"
    },
    "events-3": {
      "html": "<p style=\"white-space:pre-wrap;\" data-rte-preserve-empty=\"true\">This Award winning graphic novel is based on the true story of a Jewish immigrant who helped his Japanese-American neighbors when they were incarcerated during WWII. Through a visually engaging presentation, Tuininga shares the intricacies of his research and creative process, unraveling the profound lessons embedded in these tales of allyship and unity amidst the turbulence of wartime. <br></p>",
      "slots": [
        {
          "key": "text_01",
          "start": 64,
          "end": 454,
          "kind": "text",
          "original": "This Award winning graphic novel is based on the true story of a Jewish immigrant who helped his Japanese-American neighbors when they were incarcerated during WWII. Through a visually engaging presentation, Tuininga shares the intricacies of his research and creative process, unraveling the profound lessons embedded in these tales of allyship and unity amidst the turbulence of wartime. "
        }
      ],
      "page": "events",
      "file": "presentations"
    },
    "events-4": {
      "html": "<h4 style=\"text-align: center; ; white-space:pre-wrap;\" data-rte-preserve-empty=\"true\">Sequential: The Storytelling Power of Comic Books</h4>",
      "slots": [
        {
          "key": "text_01",
          "start": 87,
          "end": 136,
          "kind": "text",
          "original": "Sequential: The Storytelling Power of Comic Books"
        }
      ],
      "page": "events",
      "file": "presentations"
    },
    "events-5": {
      "html": "<p style=\"white-space:pre-wrap;\" data-rte-preserve-empty=\"true\">Despite the graphic novel’s skyrocketing popularity, many still see comics as less serious than traditional literature. In this talk, comic artist Josh Tuininga challenges that assumption, revealing how graphic novels engage readers in uniquely powerful ways. Tracing the surprising history of sequential art, Tuininga shows how comics have shaped culture, challenged conventions, and opened new possibilities for storytelling for artists and readers of all ages.</p>",
      "slots": [
        {
          "key": "text_01",
          "start": 64,
          "end": 527,
          "kind": "text",
          "original": "Despite the graphic novel’s skyrocketing popularity, many still see comics as less serious than traditional literature. In this talk, comic artist Josh Tuininga challenges that assumption, revealing how graphic novels engage readers in uniquely powerful ways. Tracing the surprising history of sequential art, Tuininga shows how comics have shaped culture, challenged conventions, and opened new possibilities for storytelling for artists and readers of all ages."
        }
      ],
      "page": "events",
      "file": "presentations"
    },
